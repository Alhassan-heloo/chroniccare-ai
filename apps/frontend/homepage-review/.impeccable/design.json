  "components": [
    {
      "name": "Registration",
      "kind": "button",
      "refersTo": "button-primary-light",
      "description": "Filled registration link.",
      "html": "<a class=\"ds-primary\" dir=\"rtl\" href=\"/register\">ابدأ سجلك <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M19 12H5m6-6-6 6 6 6\"/></svg></a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:17px;min-height:54px;padding:9px 24px;border-radius:7px;background:var(--accent,#aa351d);color:var(--on-accent,#fff);font:700 17px/1.85 Tahoma,sans-serif;text-decoration:none;transition:background-color 150ms ease}.ds-primary:hover{background:var(--accent-hover,#8c2715)}.ds-primary:active{background:var(--accent-active,#731d0e)}.ds-primary:focus-visible{outline:3px solid var(--focus,#1c6385);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Measurements link",
      "kind": "button",
      "description": "Underlined text link to the chart.",
      "html": "<a class=\"ds-link\" dir=\"rtl\" href=\"#measurements\">شاهد مثالًا للقياسات</a>",
      "css": ".ds-link{display:inline-flex;align-items:center;min-height:46px;color:var(--ink,#182832);font:600 16px/1.85 Tahoma,sans-serif;text-decoration:underline;text-underline-offset:5px}.ds-link:hover{color:var(--accent,#aa351d)}.ds-link:active{text-decoration-thickness:3px}.ds-link:focus-visible{outline:3px solid var(--focus,#1c6385);outline-offset:4px}"
    },
    {
      "name": "Masthead navigation",
      "kind": "nav",
      "description": "Section links with an underline on hover.",
      "html": "<nav class=\"ds-nav\" dir=\"rtl\" aria-label=\"التنقّل الرئيسي\"><a href=\"#measurements\">القياسات</a><a href=\"#visit\">قبل الموعد</a></nav>",
      "css": ".ds-nav{display:flex;gap:30px}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;color:var(--ink,#182832);font:600 15px/1.85 Tahoma,sans-serif;text-decoration:none;text-underline-offset:5px}.ds-nav a:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid var(--focus,#1c6385);outline-offset:4px}"
    },
    {
      "name": "Metric choices",
      "kind": "input",
      "description": "Native radio selector with a visible accent rule and focus outline.",
      "html": "<fieldset class=\"ds-metric\" dir=\"rtl\" aria-label=\"نوع القياس في المثال\"><label><input type=\"radio\" name=\"ds-metric\" checked><span>ضغط الدم</span></label><label><input type=\"radio\" name=\"ds-metric\"><span>سكر الدم</span></label></fieldset>",
      "css": ".ds-metric{display:inline-flex;gap:23px;margin:0;padding:0;border:0}.ds-metric label{position:relative;cursor:pointer}.ds-metric input{position:absolute;width:1px;height:1px;clip-path:inset(50%)}.ds-metric span{display:flex;align-items:center;min-height:53px;padding:3px 2px;border-bottom:3px solid transparent;color:var(--body,#415660);font:600 17px/1.85 Tahoma,sans-serif}.ds-metric label:hover span,.ds-metric input:checked+span{color:var(--ink,#182832)}.ds-metric input:checked+span{border-color:var(--accent,#aa351d)}.ds-metric input:focus-visible+span{outline:3px solid var(--focus,#1c6385);outline-offset:2px}"
    },
    {
      "name": "Visit record",
      "kind": "card",
