VITE_API_URL=http://localhost:3001/api
# Production on the same Render origin: VITE_API_URL=/api (set before vite build).
# If omitted, production defaults to /api; development retains the URL above.
# Public Firebase Web app configuration; leave blank to disable browser registration.
# Never place service-account JSON, private VAPID keys or server secrets in VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
