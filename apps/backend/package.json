{
  "name": "@chroniccare/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "auth:provision": "node --env-file-if-exists=.env --import tsx src/auth/provision.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/db/check.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1"
  }
}
