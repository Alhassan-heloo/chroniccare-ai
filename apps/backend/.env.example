# Copy to .env locally; never commit actual credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Replace CHANGE_ME locally. URL-encode special characters in passwords.
DATABASE_URL=postgresql://chroniccare_app:CHANGE_ME@localhost:5432/chroniccare
# Local PostgreSQL: disable. Remote/production: verify-full with trusted TLS.
DATABASE_SSL=disable
# Optional PEM CA path for a private certificate authority, with verify-full.
# DATABASE_SSL_CA_FILE=C:/certificates/postgres-ca.pem

# Optional: dedicated EMPTY test database, NEVER a patient/production database.
# TEST_DATABASE_URL=postgresql://chroniccare_app:CHANGE_ME@localhost:5432/chroniccare_test
# Production only, while no Admin exists: configure an independent random secret
# of at least 32 characters through your deployment secret manager. Never use VITE_.
# BOOTSTRAP_SECRET=
# Trusted installation settings (backend only; never VITE_ variables).
# APP_PUBLIC_ORIGIN=https://clinic.example
# FIRST_ADMIN_EMAIL=preauthorized-admin@clinic.example
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=configure-in-your-secret-manager
# EMAIL_FROM=ChronicCare AI <accounts@clinic.example>
# Optional exact IP of the TLS reverse proxy. Never trust arbitrary forwarded headers.
# TRUST_PROXY_IP=127.0.0.1

# Optional AI Assistant, backend only. Both key and model are required; no calls at startup.
# OPENAI_API_KEY=configure-in-your-secret-manager
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=10000
# OPENAI_MAX_OUTPUT_TOKENS=600
