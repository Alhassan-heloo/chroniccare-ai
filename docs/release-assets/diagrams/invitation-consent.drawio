<mxfile host="app.diagrams.net">
  <diagram id="consent" name="Targeted invitation and consent">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1260" pageHeight="890" background="#FFFFFF">
      <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="header" value="&lt;b&gt;ChronicCare AI · Targeted invitation lifecycle&lt;/b&gt;" style="shape=text;verticalAlign=middle;align=left;html=1;whiteSpace=wrap;fontFamily=Arial;spacing=0;fillColor=none;strokeColor=none;fontColor=#12313B;fontSize=28;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1090" height="48" as="geometry"/></mxCell>
    <mxCell id="intro" value="The invitation is scoped to the intended patient account. A valid preview reveals the doctor identity." style="shape=text;verticalAlign=middle;align=left;html=1;whiteSpace=wrap;fontFamily=Arial;spacing=0;fillColor=none;strokeColor=none;fontColor=#425B68;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="78" width="1100" height="26" as="geometry"/></mxCell>
    <mxCell id="issue" value="&lt;b&gt;Doctor issues a link&lt;/b&gt;&lt;br&gt;Opaque token · hash persisted&lt;br&gt;Ten-minute expiry" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#EDF3FA;strokeColor=#42678B;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="50" y="151" width="230" height="92" as="geometry"/></mxCell>
    <mxCell id="preview" value="&lt;b&gt;Patient opens review&lt;/b&gt;&lt;br&gt;Authentication and target check&lt;br&gt;Preview grants zero record access" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#EDF3FA;strokeColor=#42678B;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="375" y="151" width="250" height="92" as="geometry"/></mxCell>
    <mxCell id="deny" value="&lt;b&gt;Invalid / wrong account&lt;/b&gt;&lt;br&gt;Request denied&lt;br&gt;Existing permissions unaffected" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#FBF4E5;strokeColor=#886025;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="758" y="151" width="260" height="92" as="geometry"/></mxCell>
    <mxCell id="close" value="&lt;b&gt;Close review&lt;/b&gt;&lt;br&gt;Local UI dismissal&lt;br&gt;Link remains eligible" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#FFFFFF;strokeColor=#B6C9D3;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="53" y="486" width="230" height="95" as="geometry"/></mxCell>
    <mxCell id="approve" value="&lt;b&gt;Approve&lt;/b&gt;&lt;br&gt;Consume token and record consent&lt;br&gt;One transaction" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#E7F5F2;strokeColor=#087B70;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="373" y="486" width="270" height="95" as="geometry"/></mxCell>
    <mxCell id="reject" value="&lt;b&gt;Reject permanently&lt;/b&gt;&lt;br&gt;Consume token and set rejected&lt;br&gt;Existing consent remains" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#FBF4E5;strokeColor=#886025;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="737" y="486" width="281" height="95" as="geometry"/></mxCell>
    <mxCell id="read" value="&lt;b&gt;Doctor record available&lt;/b&gt;&lt;br&gt;Read-only while the approval exists" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#E7F5F2;strokeColor=#087B70;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="370" y="662" width="270" height="94" as="geometry"/></mxCell>
    <mxCell id="revoke" value="&lt;b&gt;Patient revokes&lt;/b&gt;&lt;br&gt;Later doctor reads are denied&lt;br&gt;Consumed links stay consumed" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#EDF3FA;strokeColor=#42678B;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="741" y="662" width="272" height="94" as="geometry"/></mxCell>
    <mxCell id="legend" value="Approval and rejection serialize with revocation using a patient advisory lock. Decisions also lock the invitation row. Rejection blocks approval replay." style="shape=text;verticalAlign=middle;align=left;html=1;whiteSpace=wrap;fontFamily=Arial;spacing=0;fillColor=none;strokeColor=none;fontColor=#425B68;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="809" width="1120" height="46" as="geometry"/></mxCell>
    <mxCell id="decision" value="&lt;b&gt;Patient decision&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;fillColor=#EDF3FA;strokeColor=#42678B;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="396" y="310" width="205" height="100" as="geometry"/></mxCell>
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;" edge="1" source="preview" target="decision" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e1" value="Open link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="issue" target="preview" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" value="Ineligible" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="preview" target="deny" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" value="Dismiss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="decision" target="close" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" value="Allow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="decision" target="approve" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" value="Confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="decision" target="reject" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" value="Consent exists" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="approve" target="read" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" value="Revoke access" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="read" target="revoke" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
