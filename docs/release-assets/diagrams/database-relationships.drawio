<mxfile host="app.diagrams.net">
  <diagram id="database" name="Database relationships">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1270" pageHeight="780" background="#FFFFFF">
      <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="header" value="&lt;b&gt;ChronicCare AI · Main database relationships&lt;/b&gt;" style="shape=text;verticalAlign=middle;align=left;html=1;whiteSpace=wrap;fontFamily=Arial;spacing=0;fillColor=none;strokeColor=none;fontColor=#12313B;fontSize=28;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1000" height="48" as="geometry"/></mxCell>
    <mxCell id="intro" value="Logical overview · PostgreSQL chroniccare schema · role and ownership policies are enforced in the API." style="shape=text;verticalAlign=middle;align=left;html=1;whiteSpace=wrap;fontFamily=Arial;spacing=0;fillColor=none;strokeColor=none;fontColor=#425B68;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="78" width="1110" height="30" as="geometry"/></mxCell>
    <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;patient · doctor · admin" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#E7F5F2;strokeColor=#087B70;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="475" y="317" width="252" height="99" as="geometry"/></mxCell>
    <mxCell id="sessions" value="&lt;b&gt;sessions&lt;/b&gt;&lt;br&gt;user_id · hashed session token · expiry" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#EDF3FA;strokeColor=#42678B;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="475" y="145" width="252" height="88" as="geometry"/></mxCell>
    <mxCell id="consent" value="&lt;b&gt;doctor_patient_relationships&lt;/b&gt;&lt;br&gt;doctor_id + patient_id&lt;br&gt;patient_approved_at enables reads" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#E7F5F2;strokeColor=#087B70;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="62" y="317" width="270" height="99" as="geometry"/></mxCell>
    <mxCell id="inv" value="&lt;b&gt;patient_invitations&lt;/b&gt;&lt;br&gt;doctor_id · nullable patient_id · token_hash&lt;br&gt;expiry · consumed_at · rejected" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#E7F5F2;strokeColor=#087B70;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="868" y="317" width="330" height="99" as="geometry"/></mxCell>
    <mxCell id="measure" value="&lt;b&gt;Patient-owned records&lt;/b&gt;&lt;br&gt;Measurements · typed reading and recorded_at&lt;br&gt;Medications → schedules → dose logs&lt;br&gt;Habits → daily habit_progress" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#EDF3FA;strokeColor=#42678B;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="310" y="544" width="570" height="142" as="geometry"/></mxCell>
    <mxCell id="ledger" value="&lt;b&gt;public.chroniccare_schema_migrations&lt;/b&gt;&lt;br&gt;Independent version, filename and SHA-256 ledger" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Arial;fontSize=15;spacing=10;fillColor=#FBF4E5;strokeColor=#886025;fontColor=#12313B;" vertex="1" parent="1"><mxGeometry x="866" y="141" width="334" height="87" as="geometry"/></mxCell>
    <mxCell id="legend" value="Arrows start at the referencing table or domain. This view shows core relations, with operational tables omitted." style="shape=text;verticalAlign=middle;align=left;html=1;whiteSpace=wrap;fontFamily=Arial;spacing=0;fillColor=none;strokeColor=none;fontColor=#425B68;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="720" width="1100" height="29" as="geometry"/></mxCell>
    <mxCell id="e1" value="user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#425B68;fontColor=#425B68;fontFamily=Arial;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" source="sessions" target="users" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
